@page
@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="clinic-card p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-slash fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Acceso Restringido</h3>
            <p class="text-muted mb-4">
                No dispones de los permisos o del rol correspondiente para acceder a este módulo de la clínica.
            </p>
            <a asp-page="/Index" class="btn btn-clinic-primary">
                <i class="bi bi-house-door me-1"></i> Volver al Inicio
            </a>
        </div>
    </div>
</div>
