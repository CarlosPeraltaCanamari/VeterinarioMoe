@page
@model PW3_04.Pages.Veterinarios.CreateModel
@{
    ViewData["Title"] = "Registrar Veterinario";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h4 class="fw-bold mb-1"><i class="bi bi-person-badge text-primary me-2"></i>Ficha de Médico Veterinario</h4>
                <p class="text-muted small mb-0">Registre un nuevo profesional de la salud animal</p>
            </div>
            <a asp-page="./Index" class="btn btn-sm btn-clinic-outline">
                <i class="bi bi-arrow-left"></i> Volver al listado
            </a>
        </div>

        <div class="clinic-card">
            <div class="clinic-card-body p-4">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Veterinario.Nombre" class="form-label"></label>
                            <input asp-for="Veterinario.Nombre" class="form-control" placeholder="Ej: Moe" />
                            <span asp-validation-for="Veterinario.Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Veterinario.Apellidos" class="form-label"></label>
                            <input asp-for="Veterinario.Apellidos" class="form-control" placeholder="Ej: Szyslak" />
                            <span asp-validation-for="Veterinario.Apellidos" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Veterinario.Especialidad" class="form-label">Especialidad Clínica</label>
                        <input asp-for="Veterinario.Especialidad" class="form-control" placeholder="Ej: Cirugía y Traumatología, Medicina Felina, Dermatología" />
                        <span asp-validation-for="Veterinario.Especialidad" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Veterinario.Telefono" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Veterinario.Telefono" class="form-control" placeholder="+591 71234567" />
                            </div>
                            <span asp-validation-for="Veterinario.Telefono" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Veterinario.Email" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Veterinario.Email" class="form-control" placeholder="medico@elarcademoe.com" />
                            </div>
                            <span asp-validation-for="Veterinario.Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="Veterinario.Estado" class="form-check-input" type="checkbox" role="switch" checked />
                        <label asp-for="Veterinario.Estado" class="form-check-label fw-semibold">
                            Veterinario Activo / En Turno
                        </label>
                        <div class="form-text small">Indica si el médico está disponible para asignarle nuevas citas y procedimientos.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-page="./Index" class="btn btn-clinic-outline">Cancelar</a>
                        <button type="submit" class="btn btn-clinic-primary">
                            <i class="bi bi-check-lg"></i> Guardar Ficha
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
