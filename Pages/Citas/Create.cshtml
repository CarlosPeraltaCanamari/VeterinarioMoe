@page
@model PW3_04.Pages.Citas.CreateModel
@{
    ViewData["Title"] = "Agendar Cita Médica";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h4 class="fw-bold mb-1"><i class="bi bi-calendar-plus text-primary me-2"></i>Agendar Nueva Consulta</h4>
                <p class="text-muted small mb-0">Complete la información para la asignación de turno veterinario</p>
            </div>
            <a asp-page="./Index" class="btn btn-sm btn-clinic-outline">
                <i class="bi bi-arrow-left"></i> Agenda de Citas
            </a>
        </div>

        <div class="clinic-card">
            <div class="clinic-card-body p-4">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Cita.MascotaId" class="form-label">Paciente (Mascota)</label>
                        <select asp-for="Cita.MascotaId" asp-items="Model.MascotasList" class="form-select">
                            <option value="">-- Seleccione la mascota --</option>
                        </select>
                        <span asp-validation-for="Cita.MascotaId" class="text-danger small"></span>
                        <div class="form-text small">¿Es un paciente nuevo? <a asp-page="/Mascotas/Create" target="_blank">Registrar mascota</a></div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cita.VeterinarioId" class="form-label">Médico Veterinario de Atención</label>
                        <select asp-for="Cita.VeterinarioId" asp-items="Model.VeterinariosList" class="form-select">
                            <option value="">-- Seleccione el profesional médico --</option>
                        </select>
                        <span asp-validation-for="Cita.VeterinarioId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Cita.FechaHora" class="form-label">Fecha y Hora Programada</label>
                            <input asp-for="Cita.FechaHora" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Cita.FechaHora" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cita.Estado" class="form-label">Estado Inicial</label>
                            <select asp-for="Cita.Estado" class="form-select">
                                <option value="@EstadosCita.Pendiente">@EstadosCita.Pendiente</option>
                                <option value="@EstadosCita.Completada">@EstadosCita.Completada</option>
                                <option value="@EstadosCita.Cancelada">@EstadosCita.Cancelada</option>
                            </select>
                            <span asp-validation-for="Cita.Estado" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Cita.Motivo" class="form-label">Motivo de la Cita / Sintomatología</label>
                        <textarea asp-for="Cita.Motivo" class="form-control" rows="3" placeholder="Describa el motivo de la consulta: revisión general, vacuna, urgencia, signos clínicos observados..."></textarea>
                        <span asp-validation-for="Cita.Motivo" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-page="./Index" class="btn btn-clinic-outline">Cancelar</a>
                        <button type="submit" class="btn btn-clinic-primary">
                            <i class="bi bi-calendar-check me-1"></i> Confirmar Cita
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
